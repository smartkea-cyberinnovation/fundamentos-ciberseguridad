{
  "name": "fundamentos-ciberseguridad",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "smartkea.com/introduccion-ciberseguridad/*",
      "zone_name": "smartkea.com"
    },
    {
      "pattern": "smartkea.com/fundamentos-ciberseguridad/term/*",
      "zone_name": "smartkea.com"
    },
    {
      "pattern": "smartkea.com/fundamentos-ciberseguridad/term",
      "zone_name": "smartkea.com"
    },
    {
      "pattern": "www.smartkea.com/fundamentos-ciberseguridad/term/*",
      "zone_name": "smartkea.com"
    },
    {
      "pattern": "www.smartkea.com/fundamentos-ciberseguridad/term",
      "zone_name": "smartkea.com"
    }
  ],
  "build": {
    "command": "python3 campus/cloudflare.py build",
    "cwd": ".",
    "watch_dir": [
      "formacion",
      "campus/assets",
      "campus/locales",
      "campus/index.html",
      "campus/package.json",
      "campus/build.py",
      "campus/bilingual.py",
      "campus/check_release.py",
      "campus/cloudflare.py",
      "campus/content.py",
      "campus/integral.py",
      "campus/operations.py",
      "campus/provenance.py",
      "campus/publication.py",
      "campus/release_inputs.py",
      "campus/stage_worker.py",
      "campus/term_integration.py",
      "campus/README.md",
      "campus/DESIGN.md",
      "campus/EDICION.md",
      "campus/DEPLOY-CLOUDFLARE.md",
      "campus/INTEGRATION.md",
      "campus/PUBLICACION-SEGURA.md",
      "term/assets",
      "term/content",
      "term/docs",
      "term/index.html",
      "term/README.md",
      "term/build.py",
      "term/labs/public-files.json",
      "term/labs/compose.yaml",
      "term/labs/stack.yaml",
      "term/labs/toolbox",
      "term/labs/web",
      "term/labs/scripts",
      "term/labs/config",
      "term/labs/fixtures",
      "term/labs/tests",
      "term/labs/README.md",
      "term/labs/.dockerignore",
      "term/labs/.gitignore",
      "term/labs/.env.example"
    ]
  },
  "assets": {
    "directory": "./campus/worker-dist",
    "not_found_handling": "404-page"
  }
}
