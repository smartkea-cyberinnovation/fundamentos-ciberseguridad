# This file contains no credentials. Compose can read it with --env-file.
# Images below are development references. Release deployments use repo@sha256.
KALI_IMAGE=kalilinux/kali-rolling:latest
PYTHON_IMAGE=python:3.13-slim-bookworm
LAB_TOOLBOX_IMAGE=smartkea-term-toolbox:dev
LAB_WEB_IMAGE=smartkea-term-web:dev

# The course build (not Compose) accepts these separate, public settings:
# TERM_LAB_URL=https://term-a01.smartkea.com/
# TERM_LAB_ALLOWED_ORIGINS=https://term-a01.smartkea.com
# TERM_LAB_EMBED=0
# Leave TERM_LAB_URL unset until Access + Tunnel are verified.
