[Unit]
Description=SmartKEA terminal for one dedicated student VM
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/lib/smartkea-term/ttyd-host-start.sh --read-only
WorkingDirectory=%h
UMask=0077
TasksMax=128
MemoryMax=2G
RuntimeMaxSec=3h
TimeoutStopSec=10s
KillMode=control-group
Restart=no
# User service: never enable as a root system service.
# Host sudo/Docker exercises need normal student privileges in a dedicated VM.

[Install]
WantedBy=default.target
