[Unit]
Description=SmartKEA read-only tmux observer for one dedicated student VM
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/lib/smartkea-term/ttyd-host-start.sh --observe
WorkingDirectory=%h
UMask=0077
TasksMax=32
MemoryMax=256M
RuntimeMaxSec=3h
TimeoutStopSec=10s
KillMode=control-group
Restart=no

[Install]
WantedBy=default.target
