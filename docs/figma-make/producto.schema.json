{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smartkea:figma-make:product:1.0.0",
  "title": "SmartKEA Figma Make product handoff1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractVersion",
    "updatedOn",
    "product",
    "provenance",
    "make",
    "statusVocabulary",
    "capabilities",
    "audiences",
    "journey",
    "routes",
    "routingRules",
    "content",
    "designSystem",
    "components",
    "screens",
    "exam",
    "localAssistance",
    "persistence",
    "accessibility",
    "privacyAndSecurity",
    "deployment",
    "acceptanceCriteria",
    "backlog",
    "handoff",
    "sources"
  ],
  "properties": {
    "$schema": {
      "const": "./producto.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "updatedOn": {
      "type": "string",
      "format": "date"
    },
    "product": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "required": [
        "repository",
        "canonicalBranch",
        "snapshotCommit",
        "productionVerification"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/smartkea-cyberinnovation/fundamentos-ciberseguridad"
        },
        "canonicalBranch": {
          "const": "main"
        },
        "snapshotCommit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$",
          "description": "Null in the maintained template; exact build SHA in a generated export."
        }
      }
    },
    "make": {
      "type": "object"
    },
    "statusVocabulary": {
      "type": "object"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "summary",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "$ref": "#/$defs/sourceRefs"
          }
        }
      }
    },
    "audiences": {
      "type": "array"
    },
    "journey": {
      "type": "array"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "surface",
          "origin",
          "pathTemplate",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "surface": {
            "enum": [
              "campus",
              "os",
              "exam",
              "term",
              "deployment"
            ]
          },
          "origin": {
            "enum": [
              "https://smartkea.com",
              "https://www.smartkea.com"
            ]
          },
          "pathTemplate": {
            "type": "string",
            "pattern": "^/(?:introduccion-ciberseguridad/|fundamentos-ciberseguridad/term/)"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/$defs/status"
          }
        }
      }
    },
    "routingRules": {
      "type": "object"
    },
    "content": {
      "type": "object"
    },
    "designSystem": {
      "type": "object"
    },
    "components": {
      "type": "array"
    },
    "screens": {
      "type": "array"
    },
    "exam": {
      "type": "object",
      "required": [
        "status",
        "bankSize",
        "sessionLength",
        "optionsPerQuestion",
        "bankSchemaFile",
        "sourcePath",
        "correction",
        "scoring",
        "persistence"
      ],
      "properties": {
        "status": {
          "const": "existing"
        },
        "bankSize": {
          "const": 100
        },
        "sessionLength": {
          "const": 20
        },
        "optionsPerQuestion": {
          "const": 4
        },
        "language": {
          "const": "es"
        },
        "bankSchemaVersion": {
          "const": 1
        },
        "bankSchemaFile": {
          "const": "banco-preguntas.schema.json"
        },
        "sourcePath": {
          "const": "formacion/introduccion-informatica/banco-preguntas.json"
        }
      }
    },
    "localAssistance": {
      "type": "object"
    },
    "persistence": {
      "type": "object"
    },
    "accessibility": {
      "type": "object"
    },
    "privacyAndSecurity": {
      "type": "object"
    },
    "deployment": {
      "type": "object"
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "title",
          "procedure",
          "expected",
          "sourceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-\\d{2}$"
          },
          "priority": {
            "$ref": "#/$defs/priority"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "procedure": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "$ref": "#/$defs/sourceRefs"
          }
        }
      }
    },
    "backlog": {
      "type": "array"
    },
    "handoff": {
      "type": "object"
    },
    "sources": {
      "type": "array"
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "existing",
        "proposed",
        "out_of_scope"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[RF]-[A-Z-]+$"
      },
      "uniqueItems": true
    }
  },
  "x-semanticRules": [
    "All referenced source IDs, route IDs and acceptance IDs must resolve in this file.",
    "Snapshot counts and topic distribution must match the actual attached inventory and bank.",
    "A proposed or out_of_scope capability must never be described as production-verified.",
    "No path template may replace the two canonical public prefixes."
  ]
}
